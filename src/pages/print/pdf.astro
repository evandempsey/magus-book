---
import "@fontsource/eb-garamond/400.css";
import "@fontsource/eb-garamond/400-italic.css";
import "@fontsource/eb-garamond/500.css";
import "@fontsource/eb-garamond/600.css";
import "@fontsource/source-sans-3/400.css";
import "@fontsource/source-sans-3/600.css";
import { chapters, getGroupedChapters, manifest } from "../../lib/edition";
import { localAssetPath, rewriteLocalHtmlPaths } from "../../lib/paths";
import "../../styles/pdf.css";

const coverPlate = manifest.plates.find((plate) => plate.sourceUrl.endsWith("/pl01.jpg")) ?? manifest.plates.find((plate) => plate.localPath);
const toPrintHtml = (html: string) => rewriteLocalHtmlPaths(html).replace(/\sloading="lazy"/g, "");
const grouped = getGroupedChapters();
const printChapters = chapters.map((chapter, index) => {
  const previous = chapters[index - 1];
  const startsMajorSection = !previous || previous.section !== chapter.section || /^title page$/i.test(chapter.title);

  return {
    ...chapter,
    html: toPrintHtml(chapter.html),
    startsMajorSection,
    isTitleEntry: /^title page$/i.test(chapter.title)
  };
});
---

<!doctype html>
<html lang="en" class="print-document">
  <head>
    <meta charset="utf-8" />
    <title>{manifest.title} by {manifest.author}</title>
  </head>
  <body class="print-body">
    <section class="print-cover">
      {coverPlate?.localPath && <img src={localAssetPath(coverPlate.localPath)} alt="" />}
      <div>
        <p class="print-cover-year">{manifest.publicationYear}</p>
        <h1>{manifest.title}</h1>
        <h2>{manifest.subtitle}</h2>
        <p class="print-cover-author">by {manifest.author}</p>
      </div>
    </section>

    <section class="print-toc">
      <h1>Contents</h1>
      {grouped.map((section) => (
        <section class="print-toc-section">
          <p>{section.book}</p>
          <h2>{section.title}</h2>
          <ol>
            {section.chapters.map((chapter) => (
              <li><a href={`#${chapter.slug}`}>{chapter.title}</a></li>
            ))}
          </ol>
        </section>
      ))}
    </section>

    {printChapters.map((chapter) => (
      <article class:list={["print-chapter", { "new-section": chapter.startsMajorSection, "title-entry": chapter.isTitleEntry }]} id={chapter.slug}>
        <header>
          <p>{chapter.book} · {chapter.section}</p>
          <h1>{chapter.title}</h1>
        </header>
        <div class="prose" set:html={chapter.html} />
      </article>
    ))}
  </body>
</html>
