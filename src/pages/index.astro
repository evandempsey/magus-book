---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getGroupedChapters } from "../lib/edition";
import { sitePath } from "../lib/paths";

const grouped = getGroupedChapters();
---

<BaseLayout title="The Magus">
  <main class="page-wrap home-index">
    <header class="page-heading">
      <p class="eyebrow">Francis Barrett, 1801</p>
      <h1>The Magus</h1>
      <label class="search-box">
        <span>Search contents</span>
        <input type="search" data-toc-search placeholder="Cabala, magnetism, plates" />
      </label>
    </header>

    <div class="toc-groups">
      {grouped.map((section) => (
        <section class="toc-section" id={section.id}>
          <div class="toc-section-heading">
            <p>{section.book}</p>
            <h2>{section.title}</h2>
          </div>
          <ol>
            {section.chapters.map((chapter) => (
              <li class="toc-entry" data-search={`${chapter.title} ${chapter.section} ${chapter.book}`.toLowerCase()}>
                <a href={sitePath(`/read/${chapter.slug}/`)}>
                  <span>{chapter.title}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </main>

  <script>
    const input = document.querySelector("[data-toc-search]");
    const entries = [...document.querySelectorAll(".toc-entry")];
    input?.addEventListener("input", (event) => {
      const query = event.target.value.trim().toLowerCase();
      for (const entry of entries) {
        entry.toggleAttribute("hidden", query.length > 0 && !entry.dataset.search.includes(query));
      }
    });
  </script>
</BaseLayout>
