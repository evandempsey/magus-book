<aside class="reader-controls" aria-label="Reader controls">
  <button type="button" data-text-decrease aria-label="Decrease text size">A-</button>
  <button type="button" data-text-increase aria-label="Increase text size">A+</button>
  <button type="button" data-theme-toggle aria-label="Toggle dark reading theme">Tone</button>
</aside>

<script>
  const root = document.documentElement;
  const minScale = 0.92;
  const maxScale = 1.22;

  function currentScale() {
    const value = getComputedStyle(root).getPropertyValue("--reader-scale").trim();
    return Number.parseFloat(value || "1") || 1;
  }

  function setScale(value) {
    const next = Math.min(maxScale, Math.max(minScale, value));
    const formatted = next.toFixed(2);
    root.style.setProperty("--reader-scale", formatted);
    localStorage.setItem("magus-text-scale", formatted);
  }

  document.querySelector("[data-text-decrease]")?.addEventListener("click", () => {
    setScale(currentScale() - 0.06);
  });

  document.querySelector("[data-text-increase]")?.addEventListener("click", () => {
    setScale(currentScale() + 0.06);
  });

  document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
    const next = root.dataset.theme === "night" ? "" : "night";
    root.dataset.theme = next;
    if (next) localStorage.setItem("magus-theme", next);
    else localStorage.removeItem("magus-theme");
  });
</script>
